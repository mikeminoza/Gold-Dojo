# Copy this file to .env and fill in your values. Never share or commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Run `python telegram_notify.py` after messaging your bot to find this
TELEGRAM_CHAT_ID=

# Optional: only needed if the MT5 terminal isn't already logged in.
# Leave blank to use whatever account the open terminal is logged into.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: path to terminal64.exe if you have several MT5 installs
MT5_PATH=
